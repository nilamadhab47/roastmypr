# RoastMyPR API Server - Environment Variables
# Copy this to .env and fill in your keys

# Required: Your Anthropic API key (YOUR key, users don't need this)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: Giphy API key for GIF functionality  
GIPHY_API_KEY=your-giphy-key-here

# Optional: Admin key for generating API keys and viewing stats
ADMIN_KEY=your-secret-admin-key

# Server port (defaults to 3000)
PORT=3000

# Node environment
NODE_ENV=development

# Public URL of this API — must match the Google authorized redirect:
#   {PUBLIC_API_URL}/api/auth/google/callback
PUBLIC_API_URL=https://roastmypr-production.up.railway.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=

# TypeSafe Jev — roast quality gate (fail-open if missing)
TYPESAFE_API_KEY=

# Railway Postgres — users, API keys, events, feedback
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway
